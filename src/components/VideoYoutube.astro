---
interface Props {
  videoId: string;
  title?: string;
}

const {
  videoId,
  title = "Video educativo"
} = Astro.props;
---

<div class="video-container">
  <iframe
    src={`https://www.youtube.com/embed/${videoId}`}
    title={title}
    frameborder="0"
    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
    allowfullscreen
  ></iframe>
</div>

<style>
  .video-container {
    position: relative;
    width: 100%;
    max-width: 900px;
    margin: 2rem auto;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 12px;
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
  }

  .video-container iframe {
    width: 100%;
    height: 100%;
    border: none;
  }
</style>