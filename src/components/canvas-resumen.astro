---
interface Props {
  src?: string;
  title?: string;
}

const {
  src = "https://www.canva.com/design/DAHYGLXaKEM/GtFqe3Q_PWV2iG__swCizQ/view?embed",
  title = "Activación de saberes: función, función lineal y función cuadrática",
} = Astro.props;
---

<div class="canva-container">
  <iframe
    loading="lazy"
    src={src}
    allowfullscreen
    allow="fullscreen"
    title={title}
  ></iframe>
</div>

<style>
  .canva-container {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    margin: 1.5rem 0;
    overflow: hidden;
    border-radius: 8px;
    box-shadow: 0 2px 8px rgba(63, 69, 81, 0.16);
  }

  .canva-container iframe {
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    border: none;
  }
</style>