---
const { materialId, width = 700, height = 500 } = Astro.props;
---
<div id={`ggb-${materialId}`}></div>

<script define:vars={{ materialId, width, height }}>
  function loadGGB() {
    const applet = new GGBApplet({
      material_id: materialId,
      width,
      height,
      showToolBar: false,
      showAlgebraInput: false,
    }, true);
    applet.inject(`ggb-${materialId}`);
  }

  if (!window.GGBApplet) {
    const script = document.createElement('script');
    script.src = 'https://www.geogebra.org/apps/deployggb.js';
    script.onload = loadGGB;
    document.head.appendChild(script);
  } else {
    loadGGB();
  }
</script>