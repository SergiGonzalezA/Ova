</style>


<!-- =========================================
     GEOGEBRA API
========================================== -->

<script
  is:inline
  src="https://www.geogebra.org/apps/deployggb.js"
></script>


<script>

  /* =========================================
     VARIABLES GLOBALES
  ========================================== */

  let modeloConstruido = {
    m: 10000,
    b: 20000
  };


  let geogebraApp = null;
  let geogebraAPI = null;


  /* =========================================
     FUNCIONES GENERALES
  ========================================== */

  function mostrarFeedback(
    id,
    mensaje,
    tipo
  ) {

    const elemento =
      document.getElementById(id);

    if (!elemento) return;

    elemento.innerHTML = mensaje;

    elemento.className =
      `feedback mostrar ${tipo}`;

  }


  function marcarCampo(
    elemento,
    correcto
  ) {

    if (!elemento) return;

    elemento.classList.remove(
      'campo-correcto',
      'campo-incorrecto'
    );

    elemento.classList.add(
      correcto
        ? 'campo-correcto'
        : 'campo-incorrecto'
    );

  }


  function desbloquearEtapa(
    numero
  ) {

    const etapa =
      document.querySelector(
        `[data-etapa="${numero}"]`
      );

    if (!etapa) return;

    etapa.classList.remove(
      'bloqueada'
    );


    setTimeout(() => {

      etapa.scrollIntoView({
        behavior: 'smooth',
        block: 'center'
      });

    }, 150);

  }


  function mostrarFinal() {

    const final =
      document.querySelector(
        '[data-etapa="8"]'
      );

    if (!final) return;

    final.classList.remove(
      'bloqueada'
    );


    setTimeout(() => {

      final.scrollIntoView({
        behavior: 'smooth',
        block: 'center'
      });

    }, 150);

  }


  /* =========================================
     CREAR GEOGEBRA
  ========================================== */

  function inicializarGeoGebra() {

    const contenedor =
      document.getElementById(
        'ggb-element'
      );

    if (!contenedor) return;


    if (
      typeof window.GGBApplet ===
      'undefined'
    ) {

      console.error(
        'GeoGebra deployggb.js todavía no está disponible.'
      );

      return;

    }


    const parametros = {

      appName: 'graphing',

      width: contenedor.clientWidth || 900,

      height: 500,

      material_id: 'ekcujuc6',

      showToolBar: false,

      showAlgebraInput: false,

      showMenuBar: false,

      showResetIcon: true,

      enableRightClick: false,

      enableLabelDrags: false,

      showZoomButtons: true,

      showFullscreenButton: true,

      showAnimationButton: false,

      showSuggestionButtons: false,

      borderColor: '#888888',


      appletOnLoad: function(api) {

        geogebraAPI = api;


        const loading =
          document.getElementById(
            'ggb-loading'
          );


        if (loading) {

          loading.classList.add(
            'oculto'
          );

        }


        /*

          Cuando GeoGebra termina de cargar,
          enviamos el modelo que construyó
          el estudiante.

        */

        actualizarGeoGebra();

      }

    };


    geogebraApp =
      new GGBApplet(
        parametros,
        true
      );


    geogebraApp.inject(
      'ggb-element'
    );

  }


  /* =========================================
     ACTUALIZAR MODELO EN GEOGEBRA
  ========================================== */

  function actualizarGeoGebra() {

    if (!geogebraAPI) return;


    const m =
      Number(modeloConstruido.m);

    const b =
      Number(modeloConstruido.b);


    if (
      !Number.isFinite(m) ||
      !Number.isFinite(b)
    ) {
      return;
    }


    /*
      Eliminamos la función anterior
      si existe.
    */

    try {

      geogebraAPI.deleteObject(
        'f'
      );

    } catch (error) {

      console.log(
        'No había una función anterior.'
      );

    }


    /*
      Creamos la nueva función.

      La API de GeoGebra permite ejecutar
      comandos mediante evalCommand().
    */

    geogebraAPI.evalCommand(
      `f(x)=${m}*x+${b}`
    );


    /*
      Punto inicial.

      Representa el dinero que tenía
      Camila cuando x = 0.
    */

    geogebraAPI.evalCommand(
      `A=(0,${b})`
    );


    /*
      Punto después de 10 semanas.
    */

    geogebraAPI.evalCommand(
      `B=(10,${m * 10 + b})`
    );


    /*
      Segmento visual entre ambos puntos.
    */

    geogebraAPI.evalCommand(
      's=Segment(A,B)'
    );


    /*
      Ajustamos automáticamente
      la vista para mostrar los objetos.
    */

    setTimeout(() => {

      try {

        geogebraAPI.showAllObjects();

      } catch (error) {

        console.log(
          'No fue posible ajustar la vista.'
        );

      }

    }, 300);


    /*
      Mostramos la expresión fuera
      de GeoGebra.
    */

    const texto =
      document.getElementById(
        'modelo-geogebra-texto'
      );


    if (texto) {

      const signo =
        b >= 0
          ? '+'
          : '-';


      texto.textContent =
        `f(x) = ${m}x ${signo} ${Math.abs(b)}`;

    }

  }


  /* =========================================
     ETAPA 1
  ========================================== */

  document
    .getElementById('btnEtapa1')
    ?.addEventListener(
      'click',
      () => {

        const seleccionados = [
          ...document.querySelectorAll(
            '[data-etapa="1"] input[type="checkbox"]:checked'
          )
        ].map(
          input => input.value
        );


        const correctos = [
          'semanas',
          'ahorro',
          'inicial'
        ];


        const esCorrecto =
          seleccionados.length ===
            correctos.length &&
          correctos.every(
            item =>
              seleccionados.includes(item)
          );


        if (esCorrecto) {

          mostrarFeedback(
            'feedback1',

            '✅ ¡Muy bien! Identificaste la información necesaria para construir el modelo.',

            'correcto'
          );


          desbloquearEtapa(2);

        } else {

          mostrarFeedback(
            'feedback1',

            '💡 Revisa tu selección. Piensa qué datos permiten conocer el tiempo, el cambio del ahorro y el punto de partida.',

            'incorrecto'
          );

        }

      }
    );


  /* =========================================
     ETAPA 2
  ========================================== */

  document
    .getElementById('btnEtapa2')
    ?.addEventListener(
      'click',
      () => {

        const respuestas = {

          0: 20000,
          1: 30000,
          2: 40000,
          3: 50000,
          4: 60000,
          5: 70000

        };


        let todosCorrectos = true;


        document
          .querySelectorAll(
            '.tabla-input'
          )
          .forEach(
            input => {

              const semana =
                input.dataset.semana;

              const valor =
                Number(input.value);

              const correcto =
                valor ===
                respuestas[semana];


              marcarCampo(
                input,
                correcto
              );


              if (!correcto) {

                todosCorrectos =
                  false;

              }

            }
          );


        if (todosCorrectos) {

          mostrarFeedback(
            'feedback2',

            '✅ ¡Excelente! La tabla muestra cómo aumenta el dinero semana tras semana.',

            'correcto'
          );


          desbloquearEtapa(3);

        } else {

          mostrarFeedback(
            'feedback2',

            '💡 Observa el valor de la semana 0 y compara cuánto cambia el dinero entre una semana y la siguiente.',

            'incorrecto'
          );

        }

      }
    );


  /* =========================================
     ETAPA 3
  ========================================== */

  document
    .getElementById('btnEtapa3')
    ?.addEventListener(
      'click',
      () => {

        const aumento =
          document.querySelector(
            'input[name="aumento"]:checked'
          )?.value;


        const inicial =
          document.querySelector(
            'input[name="inicial"]:checked'
          )?.value;


        const correcto =
          aumento === '10000' &&
          inicial === '20000';


        if (correcto) {

          mostrarFeedback(
            'feedback3',

            '✅ ¡Correcto! Encontraste los dos elementos fundamentales del modelo: el cambio constante y el valor inicial.',

            'correcto'
          );


          desbloquearEtapa(4);

        } else {

          mostrarFeedback(
            'feedback3',

            '💡 Revisa la tabla: compara dos semanas consecutivas para encontrar el aumento y observa la semana 0 para identificar el valor inicial.',

            'incorrecto'
          );

        }

      }
    );


  /* =========================================
     ETAPA 4
     CONSTRUCCIÓN DEL MODELO
  ========================================== */

  document
    .getElementById('btnEtapa4')
    ?.addEventListener(
      'click',
      () => {

        const inputM =
          document.getElementById(
            'coeficienteM'
          );


        const inputB =
          document.getElementById(
            'terminoB'
          );


        const m =
          Number(inputM?.value);


        const b =
          Number(inputB?.value);


        const correctoM =
          m === 10000;


        const correctoB =
          b === 20000;


        marcarCampo(
          inputM,
          correctoM
        );


        marcarCampo(
          inputB,
          correctoB
        );


        if (
          correctoM &&
          correctoB
        ) {


          /*
            Guardamos el modelo
            construido por el estudiante.
          */

          modeloConstruido = {
            m,
            b
          };


          mostrarFeedback(
            'feedback4',

            '🎉 ¡Excelente! Construiste correctamente el modelo matemático. Ahora vamos a llevarlo a GeoGebra.',

            'correcto'
          );


          /*
            Desbloqueamos GeoGebra.
          */

          desbloquearEtapa(5);


          /*
            Preparamos la etapa 6.
          */

          setTimeout(
            () => {

              desbloquearEtapa(6);

            },
            400
          );


          /*
            Si GeoGebra ya está cargado,
            actualizamos inmediatamente.
          */

          setTimeout(
            () => {

              actualizarGeoGebra();

            },
            600
          );


        } else {

          mostrarFeedback(
            'feedback4',

            '💡 Revisa qué cantidad representa el cambio semanal y cuál corresponde al valor inicial. Recuerda la estructura f(x) = mx + b.',

            'incorrecto'
          );

        }

      }
    );


  /* =========================================
     ETAPA 5
  ========================================== */

  document
    .getElementById('btnEtapa5')
    ?.addEventListener(
      'click',
      () => {

        const input =
          document.getElementById(
            'resultado10'
          );


        const resultado =
          Number(input?.value);


        const correcto =
          resultado === 120000;


        marcarCampo(
          input,
          correcto
        );


        if (correcto) {

          mostrarFeedback(
            'feedback5',

            '🎯 ¡Predicción correcta! Utilizaste el modelo para calcular un valor que no estaba en la tabla inicial.',

            'correcto'
          );


          mostrarFeedback(
            'feedback5',

            '🎯 ¡Predicción correcta! Ahora observa cómo ese modelo se representa gráficamente en GeoGebra.',

            'correcto'
          );


          desbloquearEtapa(6);


          setTimeout(
            () => {

              actualizarGeoGebra();

            },
            300
          );


        } else {

          mostrarFeedback(
            'feedback5',

            '💡 Utiliza el modelo que construiste y sustituye x por 10. Después realiza las operaciones paso a paso.',

            'incorrecto'
          );

        }

      }
    );


  /* =========================================
     ETAPA 6
  ========================================== */

  document
    .getElementById('btnEtapa6')
    ?.addEventListener(
      'click',
      () => {

        const grafica =
          document.querySelector(
            'input[name="grafica"]:checked'
          )?.value;


        const ejeY =
          document.querySelector(
            'input[name="ejeY"]:checked'
          )?.value;


        const pendiente =
          document.querySelector(
            'input[name="pendiente"]:checked'
          )?.value;


        const correcto =
          grafica === 'creciente' &&
          ejeY === 'inicial' &&
          pendiente === 'semanal';


        if (correcto) {

          mostrarFeedback(
            'feedback6',

            '🌟 ¡Muy bien! Relacionaste la expresión algebraica con su representación gráfica. La pendiente muestra el cambio semanal y el intercepto muestra el valor inicial.',

            'correcto'
          );


          desbloquearEtapa(7);

        } else {

          mostrarFeedback(
            'feedback6',

            '💡 Observa nuevamente la gráfica. Pregúntate: ¿hacia dónde sube la recta?, ¿qué valor representa cuando x = 0? y ¿qué información produce su inclinación?',

            'incorrecto'
          );

        }

      }
    );


  /* =========================================
     ETAPA 7
  ========================================== */

  document
    .getElementById('btnEtapa7')
    ?.addEventListener(
      'click',
      () => {

        const x =
          document.getElementById(
            'juanX'
          );


        const fx =
          document.getElementById(
            'juanFx'
          );


        const m =
          document.getElementById(
            'juanM'
          );


        const b =
          document.getElementById(
            'juanB'
          );


        const resultado =
          document.getElementById(
            'juanResultado'
          );


        const textoX =
          x.value
            .trim()
            .toLowerCase();


        const textoFx =
          fx.value
            .trim()
            .toLowerCase();


        const correctoX =
          textoX.includes(
            'semana'
          );


        const correctoFx =
          textoFx.includes(
            'dinero'
          );


        const correctoM =
          Number(m.value) ===
          15000;


        const correctoB =
          Number(b.value) ===
          50000;


        marcarCampo(
          x,
          correctoX
        );


        marcarCampo(
          fx,
          correctoFx
        );


        marcarCampo(
          m,
          correctoM
        );


        marcarCampo(
          b,
          correctoB
        );


        const valoresTabla = {

          0: 50000,
          2: 80000,
          4: 110000,
          6: 140000

        };


        let tablaCorrecta =
          true;


        document
          .querySelectorAll(
            '.juan-tabla'
          )
          .forEach(
            input => {

              const semana =
                input.dataset.semanaJuan;


              const valor =
                Number(input.value);


              const correcto =
                valor ===
                valoresTabla[semana];


              marcarCampo(
                input,
                correcto
              );


              if (!correcto) {

                tablaCorrecta =
                  false;

              }

            }
          );


        const resultadoCorrecto =
          Number(resultado.value) ===
          170000;


        marcarCampo(
          resultado,
          resultadoCorrecto
        );


        const todoCorrecto =
          correctoX &&
          correctoFx &&
          correctoM &&
          correctoB &&
          tablaCorrecta &&
          resultadoCorrecto;


        if (todoCorrecto) {

          mostrarFeedback(
            'feedback7',

            '🏆 ¡Desafío superado! Construiste un modelo lineal completo a partir de una nueva situación.',

            'correcto'
          );


          mostrarFinal();

        } else {

          mostrarFeedback(
            'feedback7',

            '💡 Revisa cada parte del modelo. Primero identifica las variables, después determina el cambio constante y el valor inicial. Finalmente usa tu función para completar la tabla y hacer la predicción.',

            'incorrecto'
          );

        }

      }
    );


  /* =========================================
     INICIALIZAR GEOGEBRA
  ========================================== */

  function esperarGeoGebra() {

    const etapa6 =
      document.querySelector(
        '[data-etapa="6"]'
      );


    if (!etapa6) return;


    /*
      GeoGebra se inicializa cuando
      el componente ya está disponible.
    */

    const iniciar =
      () => {

        try {

          inicializarGeoGebra();

        } catch (error) {

          console.error(
            'Error iniciando GeoGebra:',
            error
          );

        }

      };


    /*
      Esperamos un poco para asegurar
      que deployggb.js haya cargado.
    */

    if (
      typeof window.GGBApplet !==
      'undefined'
    ) {

      iniciar();

    } else {

      setTimeout(
        esperarGeoGebra,
        300
      );

    }

  }


  /*
    Astro puede ejecutar este script
    después de cargar la página.
  */

  if (
    document.readyState ===
    'loading'
  ) {

    document.addEventListener(
      'DOMContentLoaded',
      esperarGeoGebra
    );

  } else {

    esperarGeoGebra();

  }

</script>