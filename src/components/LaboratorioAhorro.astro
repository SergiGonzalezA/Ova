<div class="laboratorio">

  <!-- =========================================
       ENCABEZADO
  ========================================== -->

  <header class="lab-header">

    <span class="lab-badge">
      ACTIVIDAD 2.4
    </span>

    <h1>
      Construyendo modelos matemáticos
    </h1>

    <p>
      Aprende a construir una función lineal a partir de una situación
      cotidiana, utilizando tablas, expresiones algebraicas y gráficas.
    </p>

  </header>


  <!-- =========================================
       SITUACIÓN PROBLEMA
  ========================================== -->

  <section class="situacion">

    <div class="situacion-icono">
      💰
    </div>

    <div>

      <h2>
        Una meta de ahorro
      </h2>

      <p>
        Camila tiene <strong>$20.000</strong> ahorrados y decide guardar
        <strong>$10.000 cada semana</strong>.
      </p>

      <p>
        Ella quiere saber cuánto dinero tendrá después de varias semanas.
      </p>

    </div>

  </section>


  <!-- =========================================
       MISIÓN
  ========================================== -->

  <section class="mision">

    <div class="mision-numero">
      🎯
    </div>

    <div>

      <h2>
        Tu misión
      </h2>

      <p>
        Construye un modelo matemático que permita calcular cuánto dinero
        tendrá Camila después de cualquier número de semanas.
      </p>

      <div class="ruta">

        <span>Situación</span>
        <span>→</span>
        <span>Datos</span>
        <span>→</span>
        <span>Tabla</span>
        <span>→</span>
        <span>Función</span>
        <span>→</span>
        <span>Gráfica</span>

      </div>

    </div>

  </section>


  <!-- =========================================
       ETAPA 1
  ========================================== -->

  <section
    class="etapa"
    data-etapa="1"
  >

    <div class="etapa-header">

      <span class="etapa-numero">
        1
      </span>

      <div>

        <span class="etiqueta">
          EXPLORA
        </span>

        <h2>
          ¿Qué información necesitamos?
        </h2>

      </div>

    </div>


    <p>
      Antes de construir el modelo, identifica qué información de la
      situación será necesaria para resolver el problema.
    </p>


    <p class="instruccion">

      <strong>
        Selecciona todas las opciones que consideres necesarias.
      </strong>

    </p>


    <div class="opciones-check">


      <label class="opcion-check">

        <input
          type="checkbox"
          value="semanas"
        />

        <span>

          <strong>
            El número de semanas
          </strong>

          <small>
            Permite saber cuánto tiempo ha pasado.
          </small>

        </span>

      </label>


      <label class="opcion-check">

        <input
          type="checkbox"
          value="ahorro"
        />

        <span>

          <strong>
            La cantidad que ahorra cada semana
          </strong>

          <small>
            Permite conocer cuánto aumenta el ahorro.
          </small>

        </span>

      </label>


      <label class="opcion-check">

        <input
          type="checkbox"
          value="inicial"
        />

        <span>

          <strong>
            El dinero que tenía inicialmente
          </strong>

          <small>
            Es el punto de partida del ahorro.
          </small>

        </span>

      </label>


      <label class="opcion-check">

        <input
          type="checkbox"
          value="edad"
        />

        <span>

          <strong>
            La edad de Camila
          </strong>

          <small>
            No necesitamos este dato para construir el modelo.
          </small>

        </span>

      </label>


      <label class="opcion-check">

        <input
          type="checkbox"
          value="meses"
        />

        <span>

          <strong>
            El número de meses del año
          </strong>

          <small>
            No necesitamos esta información.
          </small>

        </span>

      </label>


    </div>


    <button
      class="btn-principal"
      id="btnEtapa1"
    >
      Comprobar
    </button>


    <div
      class="feedback"
      id="feedback1"
    ></div>

  </section>


  <!-- =========================================
       ETAPA 2
  ========================================== -->

  <section
    class="etapa bloqueada"
    data-etapa="2"
  >

    <div class="etapa-header">

      <span class="etapa-numero">
        2
      </span>

      <div>

        <span class="etiqueta">
          CONSTRUYE
        </span>

        <h2>
          Construye una tabla
        </h2>

      </div>

    </div>


    <p>
      Representa la situación mediante una tabla.
      Completa cuánto dinero tendrá Camila en cada semana.
    </p>


    <div class="tabla-wrapper">

      <table class="tabla-ahorro">

        <thead>

          <tr>

            <th>
              Semana
            </th>

            <th>
              Dinero ahorrado ($)
            </th>

          </tr>

        </thead>


        <tbody>


          <tr>

            <td>
              0
            </td>

            <td>

              <input
                type="number"
                class="tabla-input"
                data-semana="0"
                placeholder="$"
              />

            </td>

          </tr>


          <tr>

            <td>
              1
            </td>

            <td>

              <input
                type="number"
                class="tabla-input"
                data-semana="1"
                placeholder="$"
              />

            </td>

          </tr>


          <tr>

            <td>
              2
            </td>

            <td>

              <input
                type="number"
                class="tabla-input"
                data-semana="2"
                placeholder="$"
              />

            </td>

          </tr>


          <tr>

            <td>
              3
            </td>

            <td>

              <input
                type="number"
                class="tabla-input"
                data-semana="3"
                placeholder="$"
              />

            </td>

          </tr>


          <tr>

            <td>
              4
            </td>

            <td>

              <input
                type="number"
                class="tabla-input"
                data-semana="4"
                placeholder="$"
              />

            </td>

          </tr>


          <tr>

            <td>
              5
            </td>

            <td>

              <input
                type="number"
                class="tabla-input"
                data-semana="5"
                placeholder="$"
              />

            </td>

          </tr>


        </tbody>

      </table>

    </div>


    <button
      class="btn-principal"
      id="btnEtapa2"
    >
      Comprobar tabla
    </button>


    <div
      class="feedback"
      id="feedback2"
    ></div>

  </section>


  <!-- =========================================
       ETAPA 3
  ========================================== -->

  <section
    class="etapa bloqueada"
    data-etapa="3"
  >

    <div class="etapa-header">

      <span class="etapa-numero">
        3
      </span>

      <div>

        <span class="etiqueta">
          ANALIZA
        </span>

        <h2>
          Descubre el patrón
        </h2>

      </div>

    </div>


    <p>
      Observa los valores de la tabla y busca una regularidad.
    </p>


    <div class="pregunta">

      <label>
        ¿Cuánto aumenta el dinero de Camila cada semana?
      </label>


      <div class="radio-grupo">

        <label>

          <input
            type="radio"
            name="aumento"
            value="5000"
          />

          $5.000

        </label>


        <label>

          <input
            type="radio"
            name="aumento"
            value="10000"
          />

          $10.000

        </label>


        <label>

          <input
            type="radio"
            name="aumento"
            value="20000"
          />

          $20.000

        </label>

      </div>

    </div>


    <div class="pregunta">

      <label>
        ¿Cuál es el dinero que tenía Camila al comenzar?
      </label>


      <div class="radio-grupo">

        <label>

          <input
            type="radio"
            name="inicial"
            value="10000"
          />

          $10.000

        </label>


        <label>

          <input
            type="radio"
            name="inicial"
            value="20000"
          />

          $20.000

        </label>


        <label>

          <input
            type="radio"
            name="inicial"
            value="30000"
          />

          $30.000

        </label>

      </div>

    </div>


    <button
      class="btn-principal"
      id="btnEtapa3"
    >
      Comprobar
    </button>


    <div
      class="feedback"
      id="feedback3"
    ></div>

  </section>


  <!-- =========================================
       ETAPA 4
  ========================================== -->

  <section
    class="etapa bloqueada"
    data-etapa="4"
  >

    <div class="etapa-header">

      <span class="etapa-numero">
        4
      </span>

      <div>

        <span class="etiqueta">
          MODELA
        </span>

        <h2>
          Construye la función
        </h2>

      </div>

    </div>


    <p>
      Recuerda la estructura de una función lineal:
    </p>


    <div class="formula-base">
      f(x) = mx + b
    </div>


    <p>
      Utiliza el patrón que descubriste para completar la expresión.
    </p>


    <div class="formula-constructor">

      <span>
        f(x) =
      </span>


      <input
        type="number"
        id="coeficienteM"
        placeholder="m"
      />


      <span>
        x +
      </span>


      <input
        type="number"
        id="terminoB"
        placeholder="b"
      />

    </div>


    <div class="ayuda-modelo">

      <p>
        💡 <strong>Pista:</strong>
        uno de los valores representa cuánto aumenta el dinero cada semana
        y el otro representa la cantidad inicial.
      </p>

    </div>


    <button
      class="btn-principal"
      id="btnEtapa4"
    >
      Comprobar función
    </button>


    <div
      class="feedback"
      id="feedback4"
    ></div>

  </section>


  <!-- =========================================
       ETAPA 5
  ========================================== -->

  <section
    class="etapa bloqueada"
    data-etapa="5"
  >

    <div class="etapa-header">

      <span class="etapa-numero">
        5
      </span>

      <div>

        <span class="etiqueta">
          PREDICE
        </span>

        <h2>
          ¿Cuánto tendrá después de 10 semanas?
        </h2>

      </div>

    </div>


    <p>
      Utiliza el modelo que construiste para calcular cuánto dinero tendrá
      Camila después de <strong>10 semanas</strong>.
    </p>


    <div class="calculo">

      <div class="calculo-dato">

        <span>
          Semanas
        </span>

        <strong>
          10
        </strong>

      </div>


      <div class="calculo-operador">
        →
      </div>


      <div>

        <input
          type="number"
          id="resultado10"
          placeholder="¿Cuánto?"
        />

      </div>

    </div>


    <button
      class="btn-principal"
      id="btnEtapa5"
    >
      Comprobar predicción
    </button>


    <div
      class="feedback"
      id="feedback5"
    ></div>

  </section>


  <!-- =========================================
       ETAPA 6 - GEOGEBRA DINÁMICO
  ========================================== -->

  <section
    class="etapa bloqueada"
    data-etapa="6"
  >

    <div class="etapa-header">

      <span class="etapa-numero">
        6
      </span>

      <div>

        <span class="etiqueta">
          EXPLORA CON GEOGEBRA
        </span>

        <h2>
          Observa tu modelo gráficamente
        </h2>

      </div>

    </div>


    <p>
      Ahora observa cómo tu modelo matemático se transforma en una
      representación gráfica.
    </p>


    <div class="conexion-modelo">

      <div class="conexion-icono">
        🔗
      </div>

      <div>

        <strong>
          Tu modelo se conectó con GeoGebra
        </strong>

        <p>
          La gráfica que aparece a continuación corresponde a la función
          que construiste en la etapa anterior.
        </p>

      </div>

    </div>


    <!-- CONTENEDOR GEOGEBRA -->

    <div class="geogebra-contenedor">

      <div
        id="ggb-element"
        class="geogebra-app"
      ></div>

      <div
        id="ggb-loading"
        class="geogebra-loading"
      >
        <span class="spinner"></span>

        <span>
          Cargando GeoGebra...
        </span>
      </div>

    </div>


    <!-- MODELO ENVIADO -->

    <div
      id="modelo-geogebra"
      class="modelo-geogebra"
    >

      <span>
        Modelo explorado
      </span>

      <strong id="modelo-geogebra-texto">
        —
      </strong>

    </div>


    <div class="geogebra-instruccion">

      <strong>
        🔎 Explora la gráfica
      </strong>

      <ul>

        <li>
          Observa la dirección de la recta.
        </li>

        <li>
          Identifica dónde corta la recta al eje vertical.
        </li>

        <li>
          Observa qué representa la inclinación de la recta.
        </li>

        <li>
          Puedes hacer zoom y desplazarte por la gráfica.
        </li>

      </ul>

    </div>


    <!-- PREGUNTA 1 -->

    <div class="pregunta">

      <label>
        ¿Cómo es el comportamiento de la gráfica?
      </label>


      <div class="radio-grupo">

        <label>

          <input
            type="radio"
            name="grafica"
            value="decreciente"
          />

          Decreciente

        </label>


        <label>

          <input
            type="radio"
            name="grafica"
            value="constante"
          />

          Constante

        </label>


        <label>

          <input
            type="radio"
            name="grafica"
            value="creciente"
          />

          Creciente

        </label>

      </div>

    </div>


    <!-- PREGUNTA 2 -->

    <div class="pregunta">

      <label>
        ¿Qué representa el punto donde la recta corta el eje Y?
      </label>


      <div class="radio-grupo">

        <label>

          <input
            type="radio"
            name="ejeY"
            value="semanas"
          />

          El número de semanas

        </label>


        <label>

          <input
            type="radio"
            name="ejeY"
            value="inicial"
          />

          El dinero inicial

        </label>


        <label>

          <input
            type="radio"
            name="ejeY"
            value="aumento"
          />

          El aumento semanal

        </label>

      </div>

    </div>


    <!-- PREGUNTA 3 -->

    <div class="pregunta">

      <label>
        ¿Qué representa la inclinación de la recta?
      </label>


      <div class="radio-grupo">

        <label>

          <input
            type="radio"
            name="pendiente"
            value="inicial"
          />

          El dinero inicial

        </label>


        <label>

          <input
            type="radio"
            name="pendiente"
            value="semanal"
          />

          El aumento de dinero por semana

        </label>


        <label>

          <input
            type="radio"
            name="pendiente"
            value="semanas"
          />

          El número de semanas

        </label>

      </div>

    </div>


    <button
      class="btn-principal"
      id="btnEtapa6"
    >
      Comprobar
    </button>


    <div
      class="feedback"
      id="feedback6"
    ></div>

  </section>


  <!-- =========================================
       ETAPA 7
  ========================================== -->

  <section
    class="etapa bloqueada"
    data-etapa="7"
  >

    <div class="etapa-header">

      <span class="etapa-numero">
        7
      </span>

      <div>

        <span class="etiqueta">
          DESAFÍO FINAL
        </span>

        <h2>
          Ahora construye tu propio modelo
        </h2>

      </div>

    </div>


    <div class="desafio">

      <div class="desafio-icono">
        🚀
      </div>

      <div>

        <h3>
          El ahorro de Juan
        </h3>

        <p>
          Juan tiene <strong>$50.000</strong> ahorrados y decide guardar
          <strong>$15.000 cada semana</strong>.
        </p>

        <p>
          Construye un modelo que permita calcular cuánto dinero tendrá
          después de cualquier número de semanas.
        </p>

      </div>

    </div>


    <h3 class="subtitulo">
      1. Identifica las variables
    </h3>


    <div class="desafio-form">

      <div class="campo">

        <label>
          ¿Qué representa x?
        </label>

        <input
          type="text"
          id="juanX"
          placeholder="Escribe tu respuesta"
        />

      </div>


      <div class="campo">

        <label>
          ¿Qué representa f(x)?
        </label>

        <input
          type="text"
          id="juanFx"
          placeholder="Escribe tu respuesta"
        />

      </div>

    </div>


    <h3 class="subtitulo">
      2. Construye la función
    </h3>


    <div class="formula-constructor">

      <span>
        f(x) =
      </span>


      <input
        type="number"
        id="juanM"
        placeholder="m"
      />


      <span>
        x +
      </span>


      <input
        type="number"
        id="juanB"
        placeholder="b"
      />

    </div>


    <h3 class="subtitulo">
      3. Completa la tabla
    </h3>


    <div class="tabla-wrapper">

      <table class="tabla-ahorro">

        <thead>

          <tr>

            <th>
              Semana
            </th>

            <th>
              Dinero ($)
            </th>

          </tr>

        </thead>


        <tbody>


          <tr>

            <td>
              0
            </td>

            <td>

              <input
                type="number"
                class="juan-tabla"
                data-semana-juan="0"
                placeholder="$"
              />

            </td>

          </tr>


          <tr>

            <td>
              2
            </td>

            <td>

              <input
                type="number"
                class="juan-tabla"
                data-semana-juan="2"
                placeholder="$"
              />

            </td>

          </tr>


          <tr>

            <td>
              4
            </td>

            <td>

              <input
                type="number"
                class="juan-tabla"
                data-semana-juan="4"
                placeholder="$"
              />

            </td>

          </tr>


          <tr>

            <td>
              6
            </td>

            <td>

              <input
                type="number"
                class="juan-tabla"
                data-semana-juan="6"
                placeholder="$"
              />

            </td>

          </tr>


        </tbody>

      </table>

    </div>


    <h3 class="subtitulo">
      4. Predice
    </h3>


    <p>
      ¿Cuánto dinero tendrá Juan después de <strong>8 semanas</strong>?
    </p>


    <input
      type="number"
      id="juanResultado"
      placeholder="Resultado"
      class="resultado-final-input"
    />


    <button
      class="btn-principal"
      id="btnEtapa7"
    >
      Comprobar desafío
    </button>


    <div
      class="feedback"
      id="feedback7"
    ></div>

  </section>


  <!-- =========================================
       FINAL
  ========================================== -->

  <section
    class="final bloqueada"
    data-etapa="8"
  >

    <div class="final-icono">
      🏆
    </div>


    <h2>
      ¡Modelo construido!
    </h2>


    <p>
      Has recorrido el proceso completo para transformar una situación
      cotidiana en un modelo matemático.
    </p>


    <div class="modelo-final">

      <span>
        Modelo de ahorro de Camila
      </span>

      <strong>
        f(x) = 10000x + 20000
      </strong>

    </div>


    <div class="aprendizajes">


      <div>

        <strong>
          m
        </strong>

        <span>
          representa el cambio por semana.
        </span>

      </div>


      <div>

        <strong>
          b
        </strong>

        <span>
          representa el valor inicial.
        </span>

      </div>


      <div>

        <strong>
          x
        </strong>

        <span>
          representa el número de semanas.
        </span>

      </div>


    </div>


    <p class="mensaje-final">

      💡 Una función lineal permite representar matemáticamente
      situaciones en las que existe un cambio constante.

    </p>

  </section>

</div>


<!-- =========================================
     ESTILOS
========================================== -->

<style>

  .laboratorio {
    max-width: 1000px;
    margin: 0 auto;
    padding: 1rem 0 4rem;
  }


  /* HEADER */

  .lab-header {
    padding: 2.5rem 2rem;
    border-radius: 20px;
    background:
      linear-gradient(
        135deg,
        var(--sl-color-accent-low),
        var(--sl-color-bg)
      );
    border: 1px solid var(--sl-color-gray-5);
    margin-bottom: 1.5rem;
  }


  .lab-badge {
    display: inline-block;
    font-size: .8rem;
    font-weight: 800;
    letter-spacing: .08em;
    padding: .4rem .8rem;
    border-radius: 999px;
    background: var(--sl-color-accent);
    color: white;
    margin-bottom: .8rem;
  }


  .lab-header h1 {
    margin: 0 0 .8rem;
    font-size: clamp(1.8rem, 4vw, 2.6rem);
  }


  .lab-header p {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.7;
  }


  /* SITUACIÓN */

  .situacion {
    display: flex;
    gap: 1.2rem;
    align-items: flex-start;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
    border-radius: 16px;
    border: 1px solid var(--sl-color-gray-5);
    background: var(--sl-color-bg);
  }


  .situacion-icono {
    font-size: 2.3rem;
  }


  .situacion h2 {
    margin-top: 0;
  }


  .situacion p {
    line-height: 1.7;
  }


  /* MISIÓN */

  .mision {
    display: flex;
    gap: 1rem;
    padding: 1.5rem;
    margin-bottom: 2rem;
    border-radius: 16px;
    background: var(--sl-color-gray-6);
  }


  .mision-numero {
    font-size: 2rem;
  }


  .mision h2 {
    margin-top: 0;
  }


  .mision p {
    line-height: 1.7;
  }


  .ruta {
    display: flex;
    flex-wrap: wrap;
    gap: .5rem;
    align-items: center;
    font-weight: 700;
    margin-top: 1rem;
  }


  .ruta span {
    padding: .35rem .65rem;
    border-radius: 8px;
    background: var(--sl-color-bg);
  }


  /* ETAPAS */

  .etapa {
